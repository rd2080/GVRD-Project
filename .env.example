# Copy to .env.local and fill in. Never commit real credentials.
DATABASE_URL=postgres://user:password@localhost:5432/gvrd

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Demo mode: shows approval screens with synthetic data. Never enable in production.
DEMO_MODE=false
